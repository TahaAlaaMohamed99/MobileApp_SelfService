{
  "expo": {
    "name": "MegaHR Next",
    "slug": "MegaHrNext",
    "scheme": "mega.hr.next",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./src/assets/images/ios-icon-default.png",
        "dark": "./src/assets/images/ios-icon-dark.png",
        "tinted": "./src/assets/images/ios-icon-tinted.png"
      },
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "en",
          "ar"
        ],
        "NSCameraUsageDescription": "This app uses the camera for face recognition attendance",
        "NSFaceIDUsageDescription": "This app uses face detection for attendance features"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.megahr.next"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "extra": {
      "API_URL": "https://www.megahrnext.com/mobile-api",
      "Google_Play_url": "https://play.google.com/store/apps/details?id=com.megahr.next",
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "f7ac52a1-6fab-45cb-885b-89353526d633"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location"
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar"
            ],
            "android": [
              "en",
              "ar"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#F0F4FF",
            "image": "./src/assets/splash-icon.png",
            "resizeMode": "cover"
          },
          "android": {
            "backgroundColor": "#F0F4FF",
            "image": "./src/assets/splash-icon.png",
            "imageWidth": 200,
            "dark": {
              "backgroundColor": "#F0F4FF",
              "image": "./src/assets/splash-icon.png",
              "imageWidth": 200
            }
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "owner": "taha2024656"
  }
}
